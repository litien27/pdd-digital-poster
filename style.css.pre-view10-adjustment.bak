  .governance-view-content {
    gap: 8px;
  }

  .governance-relationship-diagram {
    grid-template-columns: 1fr;
    gap: 7px;
    padding: 9px;
  }

  .governance-institution-layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .governance-platform-connection {
    margin: 0;
  }

  .governance-stakeholder-connection {
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .governance-stakeholder-connection small {
    max-width: 130px;
  }

  .governance-stakeholder-list {
    grid-template-columns: repeat(auto-fit, minmax(145px, max-content));
  }

  .governance-analysis-panels {
    grid-template-columns: 1fr;
    gap: 7px;
  }

  .governance-analysis-panel {
    padding: 8px;
  }

  .governance-analysis-panel p {
    font-size: 10px;
  }

  .governance-view-sources {
    margin-right: 0;
  }
}

.service-flow > div {
  display: grid;
  min-height: 105px;
  align-content: center;
  padding: 18px;
  border: 1px solid var(--line);
  background: white;
}

.service-flow > div > span {
  color: var(--orange);
  font-family: Georgia, serif;
  font-size: 15px;
}

.service-flow strong {
  margin-top: 4px;
  color: var(--navy);
  font-size: 17px;
}

.service-flow small {
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
}

.service-flow > i {
  color: var(--orange);
  font-size: 18px;
  font-style: normal;
}

.data-footprint {
  display: flex;
  gap: 13px;
  align-items: center;
  margin-top: 14px;
  padding: 12px 16px;
  background: #eef3f7;
}

.footprint-icon {
  color: var(--orange);
  font-size: 25px;
}

.data-footprint p {
  margin: 0;
  color: #506477;
  font-size: 10px;
}

.data-footprint strong {
  margin-right: 5px;
  color: var(--navy);
}

.design-principles > div p,
.justice-triad > div p {
  margin: 7px 0 0;
  color: #53687a;
  font-size: 10px;
  line-height: 1.5;
}

.governance-chain {
  gap: 0;
  margin-top: 35px;
  border: 1px solid var(--line);
}

.governance-chain > div {
  display: grid;
  min-height: 112px;
  align-content: center;
  padding: 20px;
  border-right: 1px solid var(--line);
  background: white;
}

.governance-chain > div:last-child {
  border-right: 0;
}

.governance-chain span,
.evaluation-matrix span {
  color: var(--orange);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.13em;
}

.governance-chain strong {
  margin: 9px 0 5px;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 17px;
}

.governance-chain small {
  color: var(--muted);
  font-size: 9px;
}

.evaluation-matrix {
  margin-top: 42px;
}

.evaluation-matrix > div {
  display: grid;
  min-height: 100px;
  align-content: center;
  gap: 8px;
  padding: 19px;
  border-top: 3px solid var(--navy);
  background: #f2f6f9;
}

.evaluation-matrix > div:nth-child(2) {
  border-color: #507a60;
}

.evaluation-matrix > div:nth-child(3) {
  border-color: var(--orange);
}

.evaluation-matrix strong {
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 18px;
}

.evaluation-matrix small {
  color: var(--muted);
  font-size: 9px;
}

.alignment-line {
  display: flex;
  justify-content: center;
  gap: 15px;
  align-items: center;
  margin-top: 15px;
  padding: 13px;
  background: var(--navy);
  color: white;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-align: center;
}

.alignment-line strong {
  color: #ffb057;
  font-size: 16px;
}

.conclusion-slide {
  background: linear-gradient(135deg, #f8fafc, white 68%);
}

.conclusion-recommendations {
  gap: 10px;
  margin-top: 36px;
}

.conclusion-recommendations > div {
  display: flex;
  gap: 12px;
  align-items: start;
  padding: 16px;
  border: 1px solid var(--line);
  background: white;
}

.conclusion-recommendations > div > span {
  color: var(--orange);
  font-family: Georgia, serif;
  font-size: 17px;
}

.conclusion-recommendations p {
  display: grid;
  gap: 4px;
  margin: 0;
}

.conclusion-recommendations strong {
  color: var(--navy);
  font-size: 11px;
}

.conclusion-recommendations small {
  color: var(--muted);
  font-size: 9px;
}

.closing-line {
  max-width: 830px;
  margin: 28px 0 0;
  color: #53687a;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(15px, 1.8vw, 20px);
  line-height: 1.5;
}

.closing-line strong {
  color: var(--navy);
}

.presentation-controls {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 10px;
  align-items: center;
  padding: 12px 0;
}

.slide-arrow {
  padding: 8px 10px;
  border: 1px solid var(--line);
  background: white;
  color: var(--navy);
  cursor: pointer;
  font-size: 10px;
  font-weight: 800;
}

.slide-arrow:hover:not(:disabled) {
  border-color: var(--orange);
}

.slide-arrow:disabled {
  cursor: not-allowed;
  opacity: 0.42;
}

.view-navigation {
  display: flex;
  justify-content: center;
  gap: 5px;
}

.view-navigation button {
  width: 25px;
  height: 25px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 50%;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 8px;
  font-weight: 800;
}

.view-navigation button:hover,
.view-navigation button[aria-current="step"] {
  border-color: var(--navy);
  background: var(--navy);
  color: white;
}

.speaker-notes {
  padding: 14px 16px;
  border: 1px solid var(--line);
  background: #f8fafc;
}

.notes-heading {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.notes-heading label {
  color: var(--navy);
  font-size: 11px;
  font-weight: 800;
}

.notes-heading > span,
#notes-status {
  color: var(--muted);
  font-size: 9px;
}

#notes-editor {
  display: block;
  width: 100%;
  min-height: 220px;
  resize: vertical;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 0;
  background: white;
  color: var(--ink);
  font: inherit;
  font-size: 11px;
  line-height: 1.5;
}

#notes-status {
  margin: 5px 0 0;
}

.presentation-mode:fullscreen {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(12px, 2vw, 30px);
  background: #e8edf1;
}

.presentation-mode:fullscreen .slide-frame,
.presentation-mode:fullscreen .presentation-slide {
  min-height: 0;
}

.presentation-mode:fullscreen .slide-frame {
  height: min(76vh, 960px);
}

.presentation-mode:fullscreen #slide-frame:has(.cover-slide:not([hidden])) {
  width: min(100%, 135.1vh, 1706px);
  height: auto;
  aspect-ratio: 16 / 9;
  margin-inline: auto;
}

.presentation-mode:fullscreen .presentation-slide {
  height: 100%;
}

.presentation-mode:fullscreen .presentation-controls {
  width: min(1400px, 100%);
  margin: 0 auto;
}

.presentation-mode:fullscreen .speaker-notes {
  display: none !important;
}

.presentation-mode:fullscreen .notes-toggle {
  display: none;
}

@media (max-width: 900px) {
  .poster.is-presenting {
    padding: 18px;
  }

  .mode-hint {
    display: none;
  }

  .slide-frame {
    min-height: 560px;
  }

  .presentation-slide {
    padding: clamp(24px, 4vw, 38px);
  }

  .slide-content h2 {
    font-size: clamp(34px, 5.2vw, 48px);
  }

  .sets-diagram {
    gap: 8px;
  }

  .sets-node {
    padding: 10px;
  }

  .sets-center {
    width: 58px;
    height: 58px;
  }

  .presentation-controls {
    grid-template-columns: auto 1fr auto;
  }

  .fullscreen-button {
    grid-column: 1 / -1;
    justify-self: end;
  }

  .view-navigation {
    gap: 0;
  }

  .view-navigation button {
    width: 22px;
    height: 22px;
  }

  .synthesis {
    grid-template-columns: 1fr 1.3fr;
  }
}

@media (max-width: 580px) {
  .cover-slide .cover-content {
    transform: translate(4px, 0);
  }

  .poster.is-presenting {
    padding: 14px;
    border-top-width: 5px;
  }

  .poster.is-presenting > .mode-toolbar {
    margin-top: -6px;
  }

  .mode-toolbar {
    margin-bottom: 10px;
  }

  .mode-button {
    padding: 7px 8px;
    font-size: 9px;
  }

  .presentation-topline {
    flex-wrap: wrap;
  }

  .presenter-badge {
    order: 3;
    width: 100%;
    text-align: center;
  }

  .slide-frame {
    height: auto;
    min-height: 620px;
  }

  .presentation-slide {
    height: auto;
    min-height: 620px;
    padding: 22px 18px;
  }

  .slide-overline,
  .slide-creditline {
    font-size: 7px;
    letter-spacing: 0.08em;
  }

  .slide-content {
    padding: 20px 0;
  }

  .slide-content h2 {
    font-size: clamp(31px, 9vw, 43px);
  }

  .cover-content h1 {
    font-size: clamp(39px, 11vw, 49px);
  }

  .slide-deck {
    margin: 12px 0 20px;
    font-size: 14px;
  }

  .sets-diagram {
    gap: 5px;
    margin-top: 24px;
  }

  .sets-node {
    min-height: 130px;
    padding: 7px 4px;
  }

  .sets-node > span {
    width: 28px;
    height: 28px;
    font-size: 16px;
  }

  .sets-node strong {
    font-size: 10px;
  }

  .sets-node small {
    font-size: 7px;
  }

  .sets-center {
    width: 45px;
    height: 45px;
    border-width: 3px;
    font-size: 10px;
  }

  .sets-center small {
    font-size: 6px;
  }

  .presentation-gallery {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .presentation-gallery .field-trip-card {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: stretch;
  }

  .presentation-gallery .field-trip-image-slot {
    min-height: 100%;
    aspect-ratio: auto;
  }

  .presentation-gallery .field-trip-caption {
    align-content: center;
    padding: 7px;
  }

  .presentation-gallery .field-trip-caption p {
    font-size: 9px;
    line-height: 1.35;
  }

  .presentation-gallery .field-trip-caption > strong {
    font-size: 9px;
  }

  .presentation-gallery .field-trip-caption small {
    font-size: 8px;
  }

  .evidence-grid,
  .design-principles,
  .justice-triad,
  .evaluation-matrix,
  .conclusion-recommendations {
    grid-template-columns: 1fr;
    gap: 7px;
    margin-top: 17px;
  }

  .evidence-item,
  .design-principles > div,
  .justice-triad > div {
    display: grid;
    min-height: 0;
    grid-template-columns: 25px 1fr;
    gap: 0 7px;
    padding: 9px 11px;
  }

  .evidence-item > span,
  .design-principles > div > span,
  .justice-triad > div > span {
    grid-row: span 2;
    margin: 0;
    font-size: 13px;
  }

  .evidence-item strong,
  .design-principles strong,
  .justice-triad strong {
    font-size: 10px;
  }

  .evidence-item small,
  .design-principles > div p,
  .justice-triad > div p {
    margin: 2px 0 0;
    font-size: 8px;
  }

  .comparison-grid {
    grid-template-columns: 1fr;
    gap: 7px;
    margin-top: 20px;
  }

  .comparison-column {
    min-height: 0;
    padding: 12px;
  }

  .comparison-column h3 {
    margin: 4px 0;
    font-size: 18px;
  }

  .comparison-column p {
    font-size: 10px;
  }

  .comparison-column small {
    margin-top: 6px;
  }

  .comparison-arrow {
    justify-self: center;
    transform: rotate(90deg);
    font-size: 18px;
    line-height: 1;
  }

  .service-flow {
    grid-template-columns: 1fr;
    gap: 4px;
    margin-top: 21px;
  }

  .service-flow > div {
    min-height: 68px;
    grid-template-columns: 24px 1fr;
    align-content: center;
    padding: 8px 12px;
  }

  .service-flow > div > span {
    grid-row: span 2;
  }

  .service-flow strong {
    margin: 0;
    font-size: 12px;
  }

  .service-flow small {
    margin: 0;
    font-size: 8px;
  }

  .service-flow > i {
    justify-self: center;
    transform: rotate(90deg);
    font-size: 12px;
    line-height: 0.8;
  }

  .data-footprint {
    margin-top: 8px;
    padding: 8px;
  }

  .data-footprint p {
    font-size: 8px;
  }

  .governance-chain {
    grid-template-columns: 1fr;
    margin-top: 20px;
  }

  .governance-chain > div {
    min-height: 0;
    grid-template-columns: 50px 1fr;
    gap: 0 8px;
    padding: 10px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .governance-chain > div:last-child {
    border-bottom: 0;
  }

  .governance-chain > div span {
    grid-row: span 2;
    align-self: center;
  }

  .governance-chain strong {
    margin: 0;
    font-family: inherit;
    font-size: 10px;
  }

  .governance-chain small {
    font-size: 8px;
  }

  .evaluation-matrix {
    margin-top: 21px;
  }

  .evaluation-matrix > div {
    min-height: 0;
    grid-template-columns: 1fr 1fr;
    gap: 3px 8px;
    padding: 9px;
  }

  .evaluation-matrix > div span {
    grid-column: 1 / -1;
  }

  .evaluation-matrix strong {
    font-size: 11px;
  }

  .evaluation-matrix small {
    align-self: center;
    font-size: 8px;
  }

  .alignment-line {
    gap: 6px;
    margin-top: 12px;
    padding: 8px 4px;
    font-size: 6px;
  }

  .alignment-line strong {
    font-size: 11px;
  }

  .conclusion-recommendations {
    gap: 6px;
    margin-top: 18px;
  }

  .conclusion-recommendations > div {
    padding: 9px;
  }

  .closing-line {
    margin-top: 14px;
    font-size: 14px;
  }

  .slide-takeaway {
    gap: 8px;
    margin-top: 15px;
    padding: 9px;
  }

  .slide-takeaway span {
    font-size: 7px;
  }

  .slide-takeaway strong {
    font-size: 11px;
  }

  .slide-citation {
    margin-top: 7px;
    font-size: 8px;
  }

  .presentation-controls {
    grid-template-columns: auto 1fr auto;
    gap: 4px;
    padding: 8px 0;
  }

  .slide-arrow {
    padding: 7px 6px;
    font-size: 8px;
  }

  .view-navigation {
    flex-wrap: wrap;
    gap: 0;
  }

  .view-navigation button {
    width: 19px;
    height: 19px;
    font-size: 7px;
  }

  .fullscreen-button {
    font-size: 8px;
  }

  .notes-heading {
    display: grid;
    gap: 2px;
  }
}

@media print {
  .mode-toolbar,
  .presentation-mode {
    display: none !important;
  }

  .poster-overview,
  .poster-overview[hidden] {
    display: block !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}

.presentation-mode:fullscreen #slide-frame:has(.presentation-slide[data-view="2"]:not([hidden])),
.presentation-mode:fullscreen #slide-frame:has(.presentation-slide[data-view="3"]:not([hidden])),
.presentation-mode:fullscreen #slide-frame:has(.presentation-slide[data-view="10"]:not([hidden])) {
  width: min(100%, 135.1vh, 1706px);
  height: auto;
  aspect-ratio: 16 / 9;
  margin-inline: auto;
}

@media (max-width: 900px) {
  .cover-slide .cover-content h1 {
    font-size: clamp(36px, 6vw, 58px);
  }

  .cover-slide .cover-topic-line {
    font-size: 10px;
  }
}

@media (max-width: 580px) {
  .cover-slide .cover-content h1 {
    font-size: clamp(32px, 8vw, 44px);
  }

  .cover-slide .slide-subtitle {
    margin: 12px 0 14px;
    font-size: 14px;
    line-height: 1.4;
  }

  .cover-slide .question-callout {
    padding: 10px 12px;
  }

  .cover-slide .question-callout p {
    font-size: 14px;
  }

  .cover-slide .cover-topic-line {
    font-size: 9px;
    line-height: 1.5;
  }

  .cover-course-title {
    font-size: 9px;
  }

  .cover-brand {
    gap: 4px;
  }

  .cover-brand-logo {
    right: 18px;
    width: 74px;
    height: 42px;
    flex-basis: 42px;
  }

  .cover-slide .slide-overline {
    margin-left: -8px;
  }

  .cover-course-title {
    font-size: 8px;
    letter-spacing: 0.06em;
  }
}

@media (min-width: 581px) and (max-height: 800px) {
  .presentation-slide {
    padding-block: 18px;
  }

  .cover-slide .cover-content h1 {
    font-size: clamp(36px, 4.8vw, 62px);
  }

  .cover-slide .slide-subtitle {
    max-width: 900px;
    margin: 12px 0 15px;
    font-size: clamp(15px, 1.6vw, 19px);
  }

  .cover-slide .question-callout {
    padding: 11px 15px;
  }
}

.presentation-slide[data-view] > .slide-overline {
  align-items: flex-start;
  margin-left: -14px;
  transform: none;
}

.presentation-slide[data-view] > .slide-overline > span:first-child,
.presentation-slide[data-view="1"] > .slide-overline > span:first-child .cover-course-title {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
  line-height: 1;
}

@media (max-width: 900px) {
  .presentation-slide[data-view] > .slide-overline > span:first-child,
  .presentation-slide[data-view="1"] > .slide-overline > span:first-child .cover-course-title {
    font-size: 8px;
    letter-spacing: 0.06em;
  }
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) [data-reveal-step][hidden] {
  display: none !important;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) [data-reveal-step].reveal-entering {
  opacity: 0;
  translate: 0 8px;
  transition: opacity 300ms ease, translate 300ms ease;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) [data-reveal-step].reveal-entering.is-visible {
  opacity: 1;
  translate: 0 0;
}

.presentation-slide[data-view="10"] .sets-evaluation-arrows path.reveal-entering {
  translate: none;
  transition: opacity 300ms ease;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  margin-right: 108px;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls > div {
  display: flex;
  gap: 4px;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-progress {
  color: var(--muted);
  font-size: 8px;
  white-space: nowrap;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls button {
  display: grid;
  width: 28px;
  height: 28px;
  padding: 0;
  place-items: center;
  border: 1px solid var(--line);
  background: #fff;
  color: var(--muted);
  cursor: pointer;
  transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls button svg {
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.8;
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls button:hover:not(:disabled) {
  border-color: var(--orange);
  background: #fff8f1;
  color: var(--orange);
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls button:disabled {
  cursor: default;
  opacity: 0.5;
}

@media (prefers-reduced-motion: reduce) {
  .presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls button {
    transition: none;
  }
}

@media (max-width: 580px) {
  .presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls {
    flex-wrap: wrap;
    margin-right: 78px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) [data-reveal-step].reveal-entering,
  .presentation-slide[data-view="10"] .sets-evaluation-arrows path.reveal-entering {
    transition: none;
    translate: none;
  }
}

/* Focused projector readability refinements for Views 2–7 and 9–11. */
.refinement-icon {
  display: inline-block;
  width: 1.25em;
  height: 1.25em;
  flex: 0 0 auto;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2;
  vertical-align: -0.2em;
}

.stat-icon { width: 34px; height: 34px; margin-bottom: 4px; color: var(--orange); }
.heading-icon { width: 25px; height: 25px; color: var(--orange); }
.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="9"], [data-view="10"], [data-view="11"]) .refinement-icon {
  animation: refinement-arrive 350ms ease-out both;
}
@keyframes refinement-arrive { from { opacity: 0; translate: 0 5px; } to { opacity: 1; translate: 0 0; } }
@media (prefers-reduced-motion: reduce) {
  .presentation-slide .refinement-icon { animation: none !important; }
}

.presentation-slide[data-view="2"] .case-heading p { font-size: 17px; }
.presentation-slide[data-view="2"] .case-statistics > div { display: grid; grid-template-columns: 42px 1fr; align-items: center; column-gap: 9px; }
.presentation-slide[data-view="2"] .case-statistics .stat-icon { grid-row: span 2; }
.presentation-slide[data-view="2"] .case-statistics strong { font-size: clamp(29px, 3vw, 38px); }
.presentation-slide[data-view="2"] .case-statistics span { font-size: 15px; }
.presentation-slide[data-view="2"] .case-layer h4 { font-size: 19px; }
.presentation-slide[data-view="2"] .case-layer p { font-size: 17px; }
.presentation-slide[data-view="2"] .case-layer small { font-size: 14px; }
.presentation-slide[data-view="2"] .case-insight-label { font-size: 12px; }
.presentation-slide[data-view="2"] .case-takeaway { font-size: 18px; }
.presentation-slide[data-view="2"] .case-citations { font-size: 12px; }

.presentation-slide[data-view="3"] .presentation-gallery {
  --portrait-photo-height: clamp(190px, 34vh, 350px);
  width: min(100%, calc(var(--portrait-photo-height) * 2.4 + 32px));
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-inline: auto;
}
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-card { display: flex; flex-direction: column; }
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-image-slot {
  width: 100%; height: var(--portrait-photo-height); min-height: 0; aspect-ratio: 4 / 5; padding: 0; overflow: hidden;
}
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-image-slot img { width: 100%; height: 100%; object-fit: contain; object-position: center; }
.presentation-slide[data-view="3"] .field-trip-caption { padding: 12px 13px; }
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-caption > strong { font-size: 14px; }
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-caption p { font-size: 14px; }
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-caption small,
.presentation-slide[data-view="3"] .slide-citation { font-size: 12px; }

.presentation-slide[data-view="4"] .ecology-stat { padding: 11px 13px; }
.presentation-slide[data-view="4"] .ecology-status { font-size: 11px; }
.presentation-slide[data-view="4"] .ecology-stat h3 { font-size: 17px; }
.presentation-slide[data-view="4"] .ecology-stat p { font-size: 14px; }
.presentation-slide[data-view="4"] .ecology-citation { font-size: 12px; }
.ecology-stat { display: grid; grid-template-columns: 48px minmax(0, 1fr); align-content: start; column-gap: 10px; row-gap: 3px; }
.ecology-stat > .ecology-status { grid-column: 1 / -1; }
.ecology-stat-icon { grid-column: 1; grid-row: 2 / span 3; align-self: center; width: 42px; height: 42px; color: var(--orange); fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.ecology-stat > strong, .ecology-stat h3, .ecology-stat p, .ecology-stat .ecology-citation { grid-column: 2; }
.presentation-slide[data-view="4"]:not([hidden]) .ecology-stat-icon { animation: refinement-arrive 350ms ease-out both; }
@media (prefers-reduced-motion: reduce) { .presentation-slide[data-view="4"] .ecology-stat-icon { animation: none !important; } }

.presentation-slide[data-view="5"] .smart-pdd-application { position: relative; isolation: isolate; overflow: hidden; }
.presentation-slide[data-view="5"] .smart-pdd-application::before { position: absolute; z-index: -1; inset: 0; background: linear-gradient(rgba(0, 39, 78, .88), rgba(0, 39, 78, .88)), url("assets/PDD-main.jpg") center 47% / cover; content: ""; }
.presentation-slide[data-view="5"] .smart-pdd-application :is(span, strong) { color: #fff; }
.presentation-slide[data-view="5"] .smart-pdd-application > * { position: relative; }
.presentation-slide[data-view="5"] .smart-approach li,
.presentation-slide[data-view="5"] .smart-critical-question { font-size: 16px; }
.presentation-slide[data-view="5"] .smart-pdd-application strong { font-size: 18px; }

.presentation-slide[data-view="6"] .operations-stage h3 { font-size: 18px; }
.presentation-slide[data-view="6"] .operations-stage p { font-size: 14px; }
.presentation-slide[data-view="6"] .operations-panel h3 { display: flex; align-items: center; gap: 9px; font-size: 19px; }
.presentation-slide[data-view="6"] .operations-benefit { font-size: 17px; }
.presentation-slide[data-view="6"] .operations-benefit span { font-size: 11px; }
.presentation-slide[data-view="6"] .operations-citation,
.presentation-slide[data-view="6"] .operations-process-note,
.presentation-slide[data-view="6"] .operations-sources { font-size: 11px; }

.presentation-slide[data-view="7"] .human-outcome-panel { padding: 14px 16px; }
.presentation-slide[data-view="7"] .human-outcome-panel h3 { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; font-size: 20px; }
.presentation-slide[data-view="7"] .human-panel-stage p { font-size: 15px; }
.presentation-slide[data-view="7"] .human-panel-stage > span,
.presentation-slide[data-view="7"] .human-critical-question > span { font-size: 11px; }
.presentation-slide[data-view="7"] .human-critical-question { padding: 9px 10px; border: 1px solid rgba(239, 124, 0, .45); border-left: 4px solid var(--orange); border-radius: 8px; background: #fff4e8; }
.presentation-slide[data-view="7"] .human-critical-question strong { font-size: 16px; }
.presentation-slide[data-view="7"] .human-panel-citation,
.presentation-slide[data-view="7"] .human-development-sources { font-size: 11px; }
.presentation-slide[data-view="7"] .human-development-takeaway { font-size: 16px; }

.presentation-slide[data-view="9"] .justice-dimension-panel { padding: 14px 16px; }
.presentation-slide[data-view="9"] .justice-dimension-heading h3 { font-size: 19px; }
.presentation-slide[data-view="9"] .justice-dimension-heading p { font-size: 14px; }
.presentation-slide[data-view="9"] .justice-evidence > span { font-size: 10px; }
.presentation-slide[data-view="9"] .justice-evidence p { font-size: 15px; }
.presentation-slide[data-view="9"] .justice-evidence small { font-size: 12px; }
.presentation-slide[data-view="9"] .justice-critical-question { padding: 8px 10px; font-size: 15px; }
.presentation-slide[data-view="9"] .environmental-justice-insight { font-size: 16px; }
.presentation-slide[data-view="9"] .environmental-justice-sources { font-size: 11px; }

.presentation-slide[data-view="10"] .sets-evaluation-governance { width: min(23%, 190px); aspect-ratio: 1.4; border-radius: 24px; }
.presentation-slide[data-view="10"] .sets-evaluation-governance strong { font-size: 15px; line-height: 1.25; }
.presentation-slide[data-view="10"] .sets-evaluation-node strong { font-size: 13px; }
.presentation-slide[data-view="10"] .sets-evaluation-node p { font-size: 14px; }
.presentation-slide[data-view="10"] .sets-evaluation-node small,
.presentation-slide[data-view="10"] .sets-evaluation-figure figcaption { font-size: 11px; }
.presentation-slide[data-view="10"] .sets-evaluation-panels article span { font-size: 10px; }
.presentation-slide[data-view="10"] .sets-evaluation-panels p { font-size: 14px; line-height: 1.3; }
.presentation-slide[data-view="10"] .sets-evaluation-takeaway { font-size: 16px; }
.presentation-slide[data-view="10"] .sets-evaluation-citations > span:first-child { font-size: 11px; }
.presentation-slide[data-view="10"] .sets-evaluation-citations > span:last-child { color: var(--muted); font-size: 11px; }
.presentation-slide[data-view="10"] .sets-evaluation-citations > span:last-child a { color: inherit; text-decoration: none; pointer-events: none; }

.presentation-slide[data-view="11"] .conclusion-recommendations strong { display: flex; align-items: center; gap: 8px; font-size: 17px; }
.presentation-slide[data-view="11"] .conclusion-recommendations .heading-icon { width: 24px; height: 24px; }

/* Follow-up refinements: scoped to the views named in the updated brief. */
@media (min-width: 781px) and (min-aspect-ratio: 16/10) {
  .presentation-mode .cover-slide .slide-subtitle {
    max-width: none;
    font-size: clamp(14px, 1.05vw, 18px);
    line-height: 1.3;
    white-space: nowrap;
  }
}

.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-progress { display: none; }
.presentation-slide:is([data-view="2"], [data-view="3"], [data-view="4"], [data-view="5"], [data-view="6"], [data-view="7"], [data-view="8"], [data-view="9"], [data-view="10"], [data-view="11"]) .slide-reveal-controls { gap: 0; }

.presentation-slide[data-view="3"] .presentation-gallery .field-trip-caption { min-height: 72px; gap: 4px; padding: 8px 9px; }
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-caption > strong { font-size: 13px; }
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-caption p { font-size: 12px; line-height: 1.3; }
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-caption small,
.presentation-slide[data-view="3"] .slide-citation { font-size: 11px; }

.presentation-slide[data-view="4"] .ecology-stat { min-height: 160px; }
.presentation-slide[data-view="4"] .ecology-stat > strong { font-size: clamp(26px, 2.6vw, 34px); }
.presentation-slide[data-view="4"] .ecology-stat h3 { font-size: 17px; line-height: 1.15; }
.presentation-slide[data-view="4"] .ecology-stat p { min-height: 0; font-size: 13px; line-height: 1.3; }
.presentation-slide[data-view="4"] .ecology-citation { font-size: 11px; }
.presentation-slide[data-view="4"] .ecology-impact { padding: 12px 14px; }
.presentation-slide[data-view="4"] .ecology-impact h3 { font-size: clamp(20px, 1.55vw, 26px); line-height: 1.15; }
.presentation-slide[data-view="4"] .ecology-impact ul { gap: 9px; }
.presentation-slide[data-view="4"] .ecology-impact li { font-size: clamp(16px, 1.3vw, 21px); line-height: 1.25; }
.presentation-slide[data-view="4"] .ecology-impact-icon { flex-basis: 22px; font-size: 21px; }

.presentation-slide[data-view="5"] .smart-approach h3 { display: flex; min-height: 44px; align-items: center; gap: 10px; }
.smart-approach-icon { width: 38px; height: 38px; flex: 0 0 38px; fill: none; stroke: var(--navy); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.smart-approach-human .smart-approach-icon { stroke: var(--orange); }
.presentation-slide[data-view="5"]:not([hidden]) .smart-approach-icon { animation: refinement-arrive 350ms ease-out both; }
.presentation-slide[data-view="5"] .smart-approach-technology li:first-child { width: min(100%, 12ch); }
@media (prefers-reduced-motion: reduce) { .presentation-slide[data-view="5"] .smart-approach-icon { animation: none !important; } }

/* Precise follow-up changes for Views 1, 3, 4, 5, 8 and 10. */
@media (min-width: 781px) and (min-aspect-ratio: 16/10) {
  .presentation-mode .cover-slide .slide-subtitle {
    font-size: clamp(15px, 1.25vw, 20px);
    letter-spacing: 0;
  }
}

.presentation-slide[data-view="3"] .slide-content > .slide-kicker {
  margin-bottom: 9px;
  font-size: 12px;
}
.presentation-slide[data-view="3"] .slide-content > h2 {
  font-size: clamp(30px, 3.5vw, 50px);
}
.presentation-slide[data-view="3"] .presentation-gallery .model-slot img {
  object-fit: cover;
  object-position: center 48%;
}

.presentation-slide[data-view="4"] .ecology-takeaway {
  font-size: clamp(15px, 1.5vw, 19px);
  padding: 9px 12px;
}

.presentation-slide[data-view="5"] .smart-approach-technology ul {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
}
