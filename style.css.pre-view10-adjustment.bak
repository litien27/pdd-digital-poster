  padding: 8px 14px;
  border: 2px solid var(--navy);
  border-top: 4px solid var(--orange);
  border-radius: 999px;
  background: #fff;
}
.presentation-slide[data-view="10"] .sets-evaluation-figure { position: relative; }
.presentation-slide[data-view="10"] .sets-evaluation-governance strong {
  font-size: 20px;
