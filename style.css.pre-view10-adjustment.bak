@charset "UTF-8";

:root {
  color-scheme: light;
  --navy: #003d7c;
  --deep-navy: #002d5d;
  --ink: #172f47;
  --orange: #ef7c00;
  --muted: #637587;
  --line: #dce3e9;
  --mist: #f3f6f8;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  padding: clamp(12px, 2.5vw, 36px);
  background: #e8edf1;
  color: var(--ink);
  font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
  font-size: 13px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
}

a:focus-visible,
button:focus-visible {
  outline: 3px solid var(--orange);
  outline-offset: 3px;
}

.poster {
  width: min(1500px, 100%);
  margin: 0 auto;
  padding: clamp(22px, 3.2vw, 48px);
  border-top: 7px solid var(--orange);
  background: #fff;
  box-shadow: 0 18px 55px rgba(27, 49, 69, 0.13);
}

.poster-header {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: clamp(22px, 3vw, 45px);
  align-items: center;
  padding: 3px 0 29px;
}

.university-mark {
  display: flex;
  align-items: center;
  gap: 11px;
}

.mark-emblem {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  border-radius: 50%;
  background: var(--navy);
  color: white;
  font-family: Georgia, serif;
  font-size: 31px;
  font-weight: 700;
}

.mark-type {
  display: grid;
  line-height: 1.12;
}

.mark-type strong {
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 23px;
  letter-spacing: 0.02em;
}

.mark-type small {
  margin-top: 4px;
  color: var(--muted);
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.09em;
}

.title-block {
  padding-left: clamp(20px, 3vw, 44px);
  border-left: 1px solid var(--line);
}

.eyebrow,
.lens-kicker,
.question-tags,
.header-meta > span,
.photo-tag,
.key-question > strong {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 7px;
  color: var(--muted);
}

.eyebrow span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--orange);
}

.title-block h1 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(34px, 4vw, 55px);
  font-weight: 650;
  letter-spacing: -0.06em;
  line-height: 1;
}

.title-block h1 em {
  color: var(--orange);
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
}

.subtitle {
  margin: 9px 0 0;
  color: var(--muted);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(13px, 1.3vw, 16px);
  font-style: italic;
}

.header-meta {
  display: grid;
  justify-items: end;
  gap: 2px;
  color: var(--navy);
  text-align: right;
}

.header-meta > span {
  color: var(--muted);
  font-size: 8px;
}

.header-meta > strong {
  font-size: 12px;
  letter-spacing: 0.08em;
}

.header-meta > small {
  color: var(--muted);
  font-size: 9px;
}

.print-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 2px;
  background: white;
  color: var(--navy);
  cursor: pointer;
  font-size: 9px;
  font-weight: 700;
}

.print-button span {
  color: var(--orange);
}

.research-question {
  display: grid;
  grid-template-columns: minmax(140px, 0.65fr) 2.3fr auto;
  gap: 23px;
  align-items: center;
  padding: 18px 22px;
  background: var(--navy);
  color: white;
}

.question-label {
  display: flex;
  align-items: center;
  gap: 12px;
}

.section-number {
  color: var(--orange);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20px;
  font-weight: 700;
}

.question-label h2 {
  margin: 0;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.research-question > p {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(15px, 1.6vw, 20px);
  line-height: 1.4;
}

.research-question > p strong {
  color: #ffb057;
  font-weight: 700;
}

.question-tags {
  display: flex;
  align-items: center;
  gap: 6px;
  color: rgba(255, 255, 255, 0.74);
  font-size: 7px;
  white-space: nowrap;
}

.question-tags i {
  color: var(--orange);
  font-style: normal;
}

.analysis {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
  margin-top: 15px;
}

.lens-card {
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: clamp(15px, 1.7vw, 24px);
  border: 1px solid var(--line);
  background: #fff;
}

.lens-heading {
  display: flex;
  align-items: start;
  gap: 12px;
  padding-bottom: 13px;
  border-bottom: 1px solid var(--line);
}

.lens-heading .section-number {
  margin-top: -3px;
}

.lens-kicker {
  display: block;
  color: var(--muted);
  font-size: 8px;
}

.lens-heading h2 {
  margin: 4px 0 0;
  color: var(--navy);
  font-size: clamp(21px, 2.1vw, 29px);
  font-weight: 650;
  letter-spacing: -0.05em;
  line-height: 1.05;
}

.lens-symbol {
  display: grid;
  width: 31px;
  height: 31px;
  flex: 0 0 31px;
  margin-left: auto;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--orange);
  font-family: Georgia, serif;
  font-size: 18px;
}

.lens-lead {
  min-height: 67px;
  margin: 14px 0 10px;
  color: var(--ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(12px, 1.05vw, 14px);
  line-height: 1.5;
}

.lens-detail {
  min-height: 104px;
}

.lens-detail h3 {
  margin: 0 0 4px;
  color: var(--navy);
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.lens-detail p {
  margin: 0;
  color: #405467;
  font-size: 10px;
  line-height: 1.6;
}

.citation {
  margin-left: 2px;
  color: var(--navy);
  font-size: 9px;
  font-weight: 800;
  text-decoration-color: var(--orange);
  text-underline-offset: 2px;
}

.field-photo {
  margin: 0;
}

.photo-placeholder {
  position: relative;
  display: flex;
  min-height: clamp(115px, 12vw, 165px);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-align: center;
}

.photo-placeholder::before,
.photo-placeholder::after {
  position: absolute;
  width: 180px;
  height: 180px;
  border: 1px solid rgba(0, 61, 124, 0.12);
  border-radius: 50%;
  content: "";
}

.photo-placeholder::after {
  width: 132px;
  height: 132px;
}

.photo-green {
  background: linear-gradient(140deg, #dfebe5, #f1eee1);
}

.photo-digital {
  background: linear-gradient(140deg, #dce8f0, #e8ebf1);
}

.photo-community {
  background: linear-gradient(140deg, #f1e7db, #e8ebee);
}

.photo-placeholder > * {
  position: relative;
  z-index: 1;
}

.photo-tag {
  position: absolute;
  top: 10px;
  left: 11px;
  color: rgba(23, 47, 71, 0.65);
  font-size: 7px;
}

.photo-plus {
  display: grid;
  width: 25px;
  height: 25px;
  margin-bottom: 5px;
  place-items: center;
  border: 1px solid rgba(0, 61, 124, 0.35);
  border-radius: 50%;
  color: var(--navy);
  font-size: 17px;
}

.photo-placeholder strong {
  color: var(--navy);
  font-size: 10px;
}

.photo-placeholder small {
  color: #617589;
  font-size: 8px;
}

.field-photo figcaption {
  padding-top: 5px;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.4;
}

.field-trip-gallery {
  margin-top: 15px;
  padding: 18px 22px;
  background: var(--mist);
}

.gallery-heading {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: end;
  margin-bottom: 12px;
}

.gallery-heading h2 {
  margin: 3px 0 0;
  color: var(--navy);
  font-size: clamp(20px, 2vw, 27px);
  letter-spacing: -0.045em;
  line-height: 1.1;
}

.gallery-heading > p {
  max-width: 360px;
  margin: 0;
  color: var(--muted);
  font-size: 9px;
  text-align: right;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.field-trip-card {
  min-width: 0;
  margin: 0;
  border: 1px solid var(--line);
  background: white;
}

.field-trip-image-slot {
  display: flex;
  min-height: 125px;
  aspect-ratio: 16 / 9;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px;
  color: var(--navy);
  text-align: center;
}

.model-slot {
  background: linear-gradient(140deg, #e0e9ed, #f1eee5);
}

.solar-slot {
  background: linear-gradient(140deg, #e2e8ef, #f5f0df);
}

.mobility-slot {
  background: linear-gradient(140deg, #e1ece6, #edf0e9);
}

.field-trip-image-slot span {
  color: #53687a;
  font-size: 7px;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.field-trip-image-slot strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 15px;
}

.field-trip-caption {
  display: grid;
  gap: 5px;
  padding: 10px 11px 11px;
}

.field-trip-caption > strong {
  color: var(--navy);
  font-size: 10px;
}

.field-trip-caption p {
  margin: 0;
  color: #405467;
  font-size: 9px;
  line-height: 1.5;
}

.field-trip-caption p b {
  color: var(--ink);
}

.field-trip-caption small {
  color: var(--muted);
  font-size: 8px;
}

.presentation-gallery .field-trip-caption > strong {
  font-size: 12px;
}

.presentation-gallery .field-trip-caption p {
  font-size: 11px;
}

.presentation-gallery .field-trip-caption small {
  font-size: 9px;
}

.field-trip-gallery .field-trip-image-slot,
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-image-slot {
  min-height: 0;
  padding: 0;
  background: #f3f6f8;
}

.field-trip-gallery .field-trip-image-slot img,
.presentation-slide[data-view="3"] .presentation-gallery .field-trip-image-slot img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}

.critical-note {
  display: flex;
  gap: 8px;
  align-items: start;
  margin-top: 10px;
  padding: 8px 9px;
  border-left: 2px solid var(--orange);
  background: #fff7ef;
}

.critical-note > span {
  display: grid;
  width: 15px;
  height: 15px;
  flex: 0 0 15px;
  place-items: center;
  border-radius: 50%;
  background: var(--orange);
  color: white;
  font-size: 9px;
  font-weight: 800;
}

.critical-note p {
  margin: 0;
  color: #4c5d6c;
  font-size: 9px;
  line-height: 1.45;
}

.critical-note strong {
  display: block;
  margin-bottom: 1px;
  color: var(--ink);
  font-size: 9px;
}

.key-question {
  display: flex;
  gap: 8px;
  align-items: baseline;
  margin-top: auto;
  padding-top: 10px;
}

.key-question > strong {
  color: var(--orange);
  font-size: 8px;
}

.key-question > span {
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.35;
}

.synthesis {
  display: grid;
  grid-template-columns: 0.9fr 1.25fr 1.25fr;
  gap: 20px;
  align-items: start;
  margin-top: 15px;
  padding: 19px 22px;
  background: var(--mist);
}

.synthesis-title {
  display: flex;
  gap: 12px;
}

.synthesis-title h2 {
  margin: 5px 0 0;
  color: var(--navy);
  font-size: clamp(20px, 2vw, 27px);
  font-weight: 650;
  letter-spacing: -0.045em;
  line-height: 1.07;
}

.synthesis-copy {
  padding-left: 17px;
  border-left: 1px solid #d5dee6;
}

.synthesis-copy p {
  margin: 0;
  color: #4a5d6e;
  font-size: 9px;
  line-height: 1.6;
}

.synthesis-copy .synthesis-lead {
  margin-bottom: 7px;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.4;
}

.recommendations {
  padding-left: 18px;
  border-left: 1px solid #d5dee6;
}

.recommendations h3 {
  margin: 0 0 5px;
  color: var(--navy);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.recommendations ol {
  display: grid;
  gap: 4px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.recommendations li {
  display: grid;
  grid-template-columns: 18px 1fr;
  gap: 6px;
  align-items: start;
}

.recommendations li > span {
  color: var(--orange);
  font-family: Georgia, serif;
  font-size: 11px;
  font-weight: 700;
}

.recommendations li p {
  margin: 0;
  color: #4a5d6e;
  font-size: 8px;
  line-height: 1.45;
}

.recommendations li strong {
  color: var(--ink);
}

.poster-footer {
  display: flex;
  justify-content: space-between;
  gap: 25px;
  align-items: end;
  margin-top: 13px;
  padding-top: 10px;
  border-top: 1px solid var(--line);
}

.references h2 {
  margin: 0 0 4px;
  color: var(--navy);
  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.references ol {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 19px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.references li {
  color: var(--muted);
  font-size: 8px;
}

.references li span {
  color: var(--orange);
  font-weight: 800;
}

.credits {
  flex: 0 0 auto;
  margin: 0;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.45;
  text-align: right;
}

.credits span {
  color: #7d8b98;
}

@media (min-width: 1500px) {
  .lens-lead {
    min-height: 60px;
  }
}

@media (max-width: 900px) {
  .poster {
    padding: 24px;
  }

  .poster-header {
    grid-template-columns: auto 1fr;
  }

  .header-meta {
    display: none;
  }

  .research-question {
    grid-template-columns: 150px 1fr;
    gap: 10px 20px;
  }

  .question-tags {
    grid-column: 2;
  }

  .analysis {
    grid-template-columns: 1fr;
  }

  .field-trip-gallery {
    padding: 16px;
  }

  .gallery-grid {
    gap: 9px;
  }

  .field-trip-image-slot {
    min-height: 105px;
    padding: 9px;
  }

  .field-trip-image-slot span {
    font-size: 6px;
  }

  .field-trip-caption {
    padding: 8px;
  }

  .field-trip-caption p {
    font-size: 8px;
  }

  .lens-card {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    column-gap: 22px;
  }

  .lens-heading,
  .lens-lead,
  .lens-detail,
  .critical-note,
  .key-question {
    grid-column: 1;
  }

  .lens-heading {
    grid-row: 1;
  }

  .lens-lead {
    min-height: 0;
    grid-row: 2;
  }

  .lens-detail {
    min-height: 0;
    grid-row: 3;
  }

  .field-photo {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: stretch;
  }

  .photo-placeholder {
    height: calc(100% - 23px);
    min-height: 160px;
  }

  .critical-note {
    grid-row: 4;
  }

  .key-question {
    grid-row: 5;
  }

  .synthesis {
    grid-template-columns: 0.8fr 1.2fr;
  }

  .recommendations {
    grid-column: 1 / -1;
    padding-top: 12px;
    padding-left: 0;
    border-top: 1px solid #d5dee6;
    border-left: 0;
  }

  .recommendations ol {
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
}

@media (max-width: 580px) {
  body {
    padding: 0;
    background: white;
  }

  .poster {
    padding: 18px;
    border-top-width: 5px;
    box-shadow: none;
  }

  .poster-header {
    grid-template-columns: 1fr;
    gap: 17px;
    padding-bottom: 19px;
  }

  .university-mark {
    gap: 8px;
  }

  .mark-emblem {
    width: 36px;
    height: 36px;
    font-size: 22px;
  }

  .mark-type strong {
    font-size: 17px;
  }

  .mark-type small {
    font-size: 6px;
  }

  .title-block {
    padding-left: 0;
    border-left: 0;
  }

  .title-block h1 {
    font-size: clamp(32px, 10vw, 45px);
    line-height: 1.03;
  }

  .subtitle {
    font-size: 13px;
  }

  .research-question {
    grid-template-columns: 1fr;
    gap: 8px;
    padding: 15px;
  }

  .question-label h2 {
    font-size: 10px;
  }

  .research-question > p {
    font-size: 16px;
  }

  .question-tags {
    grid-column: 1;
  }

  .analysis {
    gap: 10px;
    margin-top: 10px;
  }

  .gallery-heading {
    display: block;
  }

  .gallery-heading > p {
    margin-top: 6px;
    text-align: left;
  }

  .field-trip-gallery {
    margin-top: 10px;
    padding: 14px;
  }

  .gallery-grid {
    grid-template-columns: 1fr;
  }

  .field-trip-image-slot {
    min-height: 150px;
  }

  .field-trip-caption {
    padding: 10px;
  }

  .field-trip-caption p {
    font-size: 10px;
  }

  .lens-card {
    display: flex;
    padding: 16px;
  }

  .lens-heading h2 {
    font-size: 25px;
  }

  .lens-lead {
    min-height: 0;
    font-size: 13px;
  }

  .lens-detail {
    min-height: 0;
    margin-bottom: 12px;
  }

  .lens-detail p {
    font-size: 11px;
  }

  .field-photo {
    width: 100%;
  }

  .photo-placeholder {
    height: auto;
    min-height: 170px;
  }

  .critical-note {
    margin-top: 11px;
  }

  .critical-note p,
  .critical-note strong {
    font-size: 10px;
  }

  .key-question > span {
    font-size: 11px;
  }

  .synthesis {
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 10px;
    padding: 16px;
  }

  .synthesis-copy,
  .recommendations {
    padding: 12px 0 0;
    border-top: 1px solid #d5dee6;
    border-left: 0;
  }

  .synthesis-copy .synthesis-lead {
    font-size: 14px;
  }

  .synthesis-copy p {
    font-size: 10px;
  }

  .recommendations {
    grid-column: auto;
  }

  .recommendations ol {
    grid-template-columns: 1fr;
  }

  .recommendations li p {
    font-size: 9px;
  }

  .poster-footer {
    display: grid;
    gap: 10px;
    align-items: start;
  }

  .references ol {
    display: grid;
    gap: 1px;
  }

  .references li {
    font-size: 9px;
  }

  .credits {
    text-align: left;
  }
}

@page {
  size: A3 landscape;
  margin: 8mm;
}

@page presentation-slide-page {
  size: 16in 9in;
  margin: 0;
}

@media print {
  html,
  body {
    width: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    background: white;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .poster {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 7mm;
    border-top-width: 2mm;
    box-shadow: none;
  }

  .poster-header {
    padding-bottom: 4mm;
  }

  .print-button {
    display: none;
  }

  .research-question {
    padding: 4mm 5mm;
  }

  .analysis {
    gap: 3mm;
    margin-top: 3mm;
  }

  .lens-card {
    padding: 4mm;
    break-inside: avoid;
  }

  .lens-lead {
    min-height: 14mm;
  }

  .lens-detail {
    min-height: 22mm;
  }

  .photo-placeholder {
    min-height: 29mm;
  }

  .critical-note {
    margin-top: 2mm;
    padding: 2mm;
  }

  .synthesis {
    margin-top: 3mm;
    padding: 4mm 5mm;
    break-inside: avoid;
  }

  .poster-footer {
    margin-top: 2mm;
    padding-top: 2mm;
  }

  body.is-exporting-slides .poster {
    width: 16in;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    box-shadow: none;
  }

  body.is-exporting-slides .poster-header,
  body.is-exporting-slides .mode-toolbar,
  body.is-exporting-slides .poster-overview,
  body.is-exporting-slides .presentation-topline,
  body.is-exporting-slides .presentation-controls,
  body.is-exporting-slides .speaker-notes,
  body.is-exporting-slides .slide-reveal-controls {
    display: none !important;
  }

  body.is-exporting-slides .presentation-mode {
    display: block !important;
    width: 16in;
    margin: 0;
    padding: 0;
    background: white;
    --slide-pad: 42px;
  }

  body.is-exporting-slides #slide-frame {
    width: 16in;
    height: auto;
    min-height: 0;
    overflow: visible;
    border: 0;
    background: white;
  }

  body.is-exporting-slides .presentation-slide,
  body.is-exporting-slides .presentation-slide[hidden] {
    display: flex !important;
    width: 16in;
    height: 9in;
    min-height: 0;
    margin: 0;
    page: presentation-slide-page;
    break-after: page;
    page-break-after: always;
  }

  body.is-exporting-slides .presentation-slide:last-child {
    break-after: auto;
    page-break-after: auto;
  }

  body.is-exporting-slides .presentation-slide [data-reveal-step][hidden] {
    display: revert !important;
  }

  body.is-exporting-slides .presentation-slide [data-reveal-step] {
    opacity: 1 !important;
    translate: none !important;
    transition: none !important;
  }

  body.is-exporting-slides,
  body.is-exporting-slides .presentation-slide {
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
}

.mode-toolbar {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  margin: -8px 0 17px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
}

.mode-buttons {
  display: flex;
  gap: 7px;
}

.mode-button {
  padding: 8px 12px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 10px;
  font-weight: 750;
}

.mode-button:hover,
.mode-button.is-selected {
  border-color: var(--line);
  background: white;
  color: var(--navy);
}

.mode-button.is-selected {
  box-shadow: inset 0 -2px var(--orange);
}

.mode-button span {
  margin-left: 4px;
  color: var(--orange);
}

.mode-hint {
  color: var(--muted);
  font-size: 9px;
}

.presentation-mode[hidden],
.poster-overview[hidden],
.presentation-slide[hidden],
.speaker-notes[hidden] {
  display: none !important;
}

.poster.is-presenting {
  padding-bottom: 24px;
}

.poster.is-presenting > .poster-header {
  display: none;
}

.poster.is-presenting > .mode-toolbar {
  margin-top: -20px;
}

.presentation-mode {
  --slide-pad: clamp(22px, 3vw, 42px);
}

.presentation-topline {
  display: flex;
  min-height: 36px;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 10px;
}

.view-counter {
  display: flex;
  align-items: baseline;
  gap: 8px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.view-counter strong {
  color: var(--orange);
  font-family: Georgia, serif;
  font-size: 20px;
}

.presenter-badge {
  padding: 5px 9px;
  background: #eef3f7;
  color: var(--navy);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.09em;
}

.notes-toggle,
.fullscreen-button {
  padding: 7px 10px;
  border: 1px solid var(--line);
  background: white;
  color: var(--navy);
  cursor: pointer;
  font-size: 9px;
  font-weight: 750;
}

.notes-toggle:hover,
.fullscreen-button:hover {
  border-color: var(--orange);
}

#presentation .presentation-topline .notes-toggle {
  display: none;
}

.notes-toggle span {
  margin-left: 6px;
  color: var(--orange);
}

.slide-frame {
  position: relative;
  height: min(82svh, 820px);
  min-height: 580px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-top: 5px solid var(--orange);
  background:
    linear-gradient(rgba(0, 61, 124, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 61, 124, 0.025) 1px, transparent 1px),
    #fff;
  background-size: 32px 32px;
}

.presentation-slide {
  position: relative;
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  justify-content: space-between;
  padding: var(--slide-pad);
  overflow: hidden;
}

.presentation-slide::after {
  position: absolute;
  z-index: 0;
  top: 20%;
  right: -7%;
  width: min(38vw, 440px);
  aspect-ratio: 1;
  border: 1px solid rgba(0, 61, 124, 0.09);
  border-radius: 50%;
  box-shadow: 0 0 0 55px rgba(0, 61, 124, 0.018), 0 0 0 110px rgba(0, 61, 124, 0.014);
  content: "";
  pointer-events: none;
}

.slide-overline,
.slide-creditline {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.slide-overline span:last-child {
  color: var(--navy);
}

.slide-content,
.cover-content {
  position: relative;
  z-index: 1;
  width: min(100%, 1100px);
  margin: auto;
  padding: 12px 0;
}

.slide-kicker {
  margin: 0 0 15px;
  color: var(--orange);
  font-size: 14px;
  font-weight: 850;
  letter-spacing: 0.15em;
}

.slide-content h2,
.cover-content h1 {
  max-width: 930px;
  margin: 0;
  color: var(--navy);
  font-size: clamp(32px, 3.8vw, 54px);
  font-weight: 650;
  letter-spacing: -0.065em;
  line-height: 1.02;
}

.slide-content h2 em,
.cover-content h1 em {
  color: var(--orange);
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
}

.slide-deck {
  max-width: 720px;
  margin: 10px 0 16px;
  color: #53687a;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(14px, 1.35vw, 17px);
  line-height: 1.5;
}

.slide-takeaway {
  display: flex;
  gap: 15px;
  align-items: center;
  margin-top: 12px;
  padding: 14px 17px;
  border-left: 3px solid var(--orange);
  background: #f2f6f9;
}

.slide-takeaway span {
  flex: 0 0 auto;
  color: var(--orange);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.slide-takeaway strong {
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(13px, 1.55vw, 18px);
  line-height: 1.4;
}

.slide-citation {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 9px;
}

.fieldwork-insight {
  font-size: clamp(11px, 1.05vw, 13px);
  line-height: 1.4;
}

.fieldwork-insight strong {
  color: var(--navy);
  font-weight: 850;
}

.slide-citation a {
  color: var(--navy);
  font-weight: 800;
  text-decoration-color: var(--orange);
  text-underline-offset: 3px;
}

.cover-slide {
  background-color: var(--navy);
  background-image:
    linear-gradient(115deg, rgba(0, 61, 124, 0.84), rgba(0, 61, 124, 0.78)),
    url("assets/PDD-main.jpg");
  background-position: center;
  background-size: cover;
  color: white;
}

.cover-slide .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.cover-brand {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-width: 0;
  align-items: flex-start;
  gap: 3px;
}

.cover-brand-logo {
  position: absolute;
  z-index: 2;
  right: var(--slide-pad);
  bottom: 12px;
  display: grid;
  width: 90px;
  height: 50px;
  flex: 0 0 50px;
  place-items: center;
  overflow: hidden;
  padding: 0;
  background: white;
}

.cover-brand-logo img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.cover-course-title {
  order: -1;
  min-width: 0;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.cover-slide::before {
  position: absolute;
  top: -20%;
  right: 2%;
  width: min(58vw, 650px);
  aspect-ratio: 1;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  box-shadow: 0 0 0 75px rgba(255, 255, 255, 0.025), 0 0 0 150px rgba(255, 255, 255, 0.02);
  content: "";
}

.cover-slide .slide-overline,
.cover-slide .slide-creditline {
  color: rgba(255, 255, 255, 0.65);
}

.cover-slide .slide-overline span:last-child {
  color: #ffb057;
}

.presentation-slide[data-view="2"] .slide-overline span:last-child {
  margin-left: auto;
}

.presentation-slide[data-view="2"] .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.presentation-slide[data-view="2"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.presentation-slide[data-view="3"] .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.presentation-slide[data-view="3"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.presentation-slide[data-view="3"] .slide-content {
  transform: translateY(-20px);
}

.presentation-slide[data-view="4"] .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.presentation-slide[data-view="4"] .slide-overline span:last-child {
  margin-left: auto;
}

.presentation-slide[data-view="4"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.presentation-slide[data-view="5"] .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.presentation-slide[data-view="5"] .slide-overline span:last-child {
  margin-left: auto;
}

.presentation-slide[data-view="5"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.smart-urbanism-content {
  display: grid;
  width: min(100%, 1120px);
  gap: clamp(7px, 1vh, 10px);
  margin: auto;
  padding: 0;
}

.smart-urbanism-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(26px, 3vw, 36px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.smart-urbanism-heading p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: clamp(12px, 1.2vw, 15px);
}

.smart-comparison {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.smart-approach {
  min-width: 0;
  padding: 12px 16px;
  border-top: 3px solid var(--navy);
  background: #f5f8fa;
}

.smart-approach-human {
  border-top-color: var(--orange);
  background: #fff8f1;
}

.smart-approach-tag {
  color: var(--muted);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.smart-approach-human .smart-approach-tag {
  color: var(--orange);
}

.smart-approach h3 {
  margin: 4px 0 6px;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(20px, 2.2vw, 26px);
}

.smart-approach ul {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.smart-approach li {
  color: #405467;
  font-size: 13px;
  line-height: 1.35;
}

.smart-citations {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 8px;
}

.smart-fit-heading {
  margin: 4px 0 0;
  color: var(--navy);
  font-size: clamp(17px, 2vw, 23px);
  font-weight: 850;
  letter-spacing: 0.04em;
  text-align: center;
}

.smart-pdd-application {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
  padding: 11px 14px;
  border: 1px solid var(--line);
  background: #f5f8fa;
}

.smart-pdd-capability,
.smart-pdd-outcomes {
  min-width: 0;
}

.smart-pdd-capability > span,
.smart-pdd-outcomes > span {
  display: block;
  margin-bottom: 5px;
  color: var(--orange);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.smart-pdd-capability > strong,
.smart-pdd-outcomes > strong {
  display: block;
  color: var(--navy);
  font-size: clamp(12px, 1.45vw, 17px);
  line-height: 1.3;
}

.smart-pdd-outcomes {
  padding-left: 12px;
  border-left: 1px solid var(--line);
}

.smart-pdd-arrow {
  color: var(--orange);
  font-size: 26px;
  font-weight: 800;
  text-align: center;
}

.smart-critical-question {
  margin: 0;
  padding: 8px 12px;
  border-left: 3px solid var(--orange);
  color: var(--navy);
  font-size: clamp(14px, 1.6vw, 19px);
  font-weight: 800;
  line-height: 1.25;
}

.smart-urbanism-sources {
  color: var(--muted);
  font-size: 8px;
  line-height: 1.3;
}

.ecology-content {
  display: grid;
  width: min(100%, 1120px);
  gap: clamp(7px, 1vh, 10px);
  margin: auto;
  padding: 0;
}

.ecology-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(25px, 3vw, 36px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.ecology-heading h2 span {
  color: var(--orange);
}

.ecology-heading p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: clamp(11px, 1.15vw, 14px);
}

.ecology-statistics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.ecology-stat {
  min-width: 0;
  padding: 8px 11px;
  border-top: 2px solid var(--orange);
  background: #f5f8fa;
}

.ecology-status {
  display: block;
  color: var(--orange);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.09em;
}

.ecology-stat > strong {
  display: block;
  margin-top: 2px;
  color: var(--navy);
  font-size: clamp(26px, 3vw, 36px);
  line-height: 1;
  white-space: nowrap;
}

.ecology-stat > strong small {
  font-size: 0.48em;
}

.ecology-stat h3 {
  margin: 4px 0 0;
  color: var(--navy);
  font-size: 14px;
}

.ecology-stat p {
  min-height: 2.5em;
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.35;
}

.ecology-citation {
  display: block;
  margin-top: 3px;
  color: var(--navy);
  font-size: 9px;
}

.ecology-analysis {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  gap: 14px;
}

.ecology-impact {
  min-width: 0;
  padding: 9px 11px;
  border: 1px solid var(--line);
  background: white;
}

.ecology-impact h3 {
  margin: 0 0 5px;
  color: var(--navy);
  font-size: 14px;
}

.ecology-impact ul {
  display: grid;
  gap: 7px;
  margin: 0;
  padding: 0;
  list-style: none;
  color: var(--ink);
  font-size: 11px;
  line-height: 1.35;
}

.ecology-impact li {
  display: flex;
  gap: 7px;
  align-items: flex-start;
}

.ecology-impact-icon {
  flex: 0 0 14px;
  font-weight: 850;
  text-align: center;
}

.ecology-impact-check {
  color: #21845b;
}

.ecology-impact-cross {
  color: var(--orange);
}

.ecology-takeaway {
  margin: 0;
  padding: 7px 10px;
  border-left: 3px solid var(--orange);
  background: #f5f8fa;
  color: var(--navy);
  font-size: clamp(12px, 1.3vw, 15px);
  font-weight: 800;
  line-height: 1.25;
}

.ecology-footer p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.3;
}

.ecology-footer p:last-child {
  color: var(--navy);
}

@media (max-width: 580px) {
  .presentation-slide[data-view="4"] .slide-overline {
    margin-left: -8px;
  }

  .presentation-slide[data-view="4"] .slide-overline span:first-child {
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .presentation-slide[data-view="5"] .slide-overline {
    margin-left: -8px;
  }

  .presentation-slide[data-view="5"] .slide-overline span:first-child {
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .smart-comparison {
    gap: 7px;
  }

  .smart-approach {
    padding: 9px;
  }

  .smart-approach ul {
    grid-template-columns: 1fr;
    gap: 3px;
  }

  .smart-pdd-application {
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 9px;
  }

  .smart-pdd-arrow {
    transform: rotate(90deg);
    line-height: 0.8;
  }

  .smart-pdd-outcomes {
    padding: 0;
    border: 0;
  }
}

.cover-content {
  width: min(100%, 960px);
}

.cover-content h1 {
  color: white;
  font-size: clamp(42px, 6.2vw, 84px);
  line-height: 0.98;
}

.cover-content h1 em {
  color: #ff9a37;
}

.cover-content .slide-kicker {
  color: rgba(255, 255, 255, 0.72);
}

.slide-subtitle {
  max-width: 620px;
  margin: 20px 0 25px;
  color: rgba(255, 255, 255, 0.75);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(16px, 2vw, 22px);
}

.question-callout {
  max-width: 720px;
  padding: 14px 18px;
  border-left: 3px solid var(--orange);
  background: rgba(255, 255, 255, 0.09);
}

.question-callout > span {
  color: #ffb057;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.13em;
}

.question-callout p {
  margin: 5px 0 0;
  color: white;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(15px, 1.6vw, 19px);
}

.question-callout strong {
  color: #ffb057;
}

.cover-slide .slide-creditline span:last-child {
  color: #ffb057;
}

.cover-slide .cover-content {
  width: min(100%, 1050px);
  transform: translate(24px, -44px);
}

.cover-slide .cover-case-label {
  margin-bottom: 12px;
  color: #ffb057;
  font-size: clamp(14px, 1.4vw, 18px);
}

.cover-slide .cover-content h1 {
  max-width: 1000px;
  font-size: clamp(40px, 5.3vw, 72px);
  line-height: 1.04;
}

.cover-slide .slide-subtitle {
  max-width: 780px;
  margin: 17px 0 20px;
}

.cover-slide .question-callout {
  max-width: 840px;
}

.cover-slide .question-callout p {
  line-height: 1.45;
}

.cover-slide .cover-topic-line {
  margin: 18px 0 0;
  color: #ffb057;
  font-size: 12px;
  letter-spacing: 0.1em;
}

.sets-diagram {
  position: relative;
  display: grid;
  width: min(100%, 780px);
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin: 21px auto 0;
}

.sets-node {
  display: grid;
  min-height: 120px;
  align-content: center;
  justify-items: center;
  padding: 16px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
}

.sets-node > span {
  display: grid;
  width: 35px;
  height: 35px;
  margin-bottom: 8px;
  place-items: center;
  border-radius: 50%;
  background: var(--navy);
  color: white;
  font-family: Georgia, serif;
  font-size: 20px;
}

.sets-ecological > span {
  background: #507a60;
}

.sets-technical > span {
  background: var(--orange);
}

.sets-node strong {
  color: var(--navy);
  font-size: 14px;
}

.sets-node small {
  margin-top: 4px;
  color: var(--muted);
  font-size: 9px;
  line-height: 1.5;
}

.sets-center {
  position: absolute;
  top: 50%;
  left: 50%;
  display: grid;
  width: 70px;
  height: 70px;
  align-content: center;
  justify-items: center;
  transform: translate(-50%, -50%);
  border: 4px solid white;
  border-radius: 50%;
  background: var(--navy);
  color: white;
  font-size: 14px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.sets-center small {
  color: rgba(255, 255, 255, 0.76);
  font-size: 7px;
  font-weight: 500;
  letter-spacing: 0;
}

.case-view-content {
  position: relative;
  z-index: 1;
  display: flex;
  width: min(100%, 1120px);
  flex-direction: column;
  gap: clamp(7px, 1.1vh, 12px);
  margin: auto;
  padding: 3px 0;
}

.case-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(27px, 3.1vw, 40px);
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.case-heading p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: clamp(12px, 1.25vw, 16px);
}

.case-statistics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 9px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.case-statistics > div {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 1px;
  padding: 0 18px;
  border-right: 1px solid var(--line);
}

.case-statistics > div:first-child {
  padding-left: 0;
}

.case-statistics > div:last-child {
  padding-right: 0;
  border-right: 0;
}

.case-statistics strong {
  color: var(--navy);
  font-size: clamp(23px, 2.4vw, 31px);
  line-height: 1;
}

.case-statistics span {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.04em;
}

.presentation-slide[data-view="2"] .case-statistics strong {
  color: #ef7c00;
  font-weight: 850;
}

.presentation-slide[data-view="2"] .case-statistics span {
  color: #405467;
}

.case-systems {
  margin-top: clamp(4px, 0.8vh, 9px);
  padding: clamp(10px, 1.25vw, 16px);
  border: 1px solid var(--line);
  background: #f7fafc;
}

.case-systems-heading {
  margin: 0 0 12px;
  color: var(--navy);
  font-size: clamp(19px, 2vw, 25px);
  text-align: center;
}

.case-diagram {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1.15fr) 44px minmax(0, 1fr);
  align-items: stretch;
}

.case-layer {
  display: flex;
  min-width: 0;
  min-height: 78px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 5px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.96);
}

.case-layer h4 {
  margin: 0;
  color: var(--orange);
  font-size: 12px;
  letter-spacing: 0.06em;
}

.case-layer p {
  margin: 0;
  color: var(--navy);
  font-size: 13px;
  font-weight: 650;
  line-height: 1.35;
}

.case-relationship {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  color: #9a4a00;
  font-size: 19px;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.case-relationship::before {
  width: 100%;
  margin-right: -100%;
  border-top: 1px dashed var(--orange);
  content: "";
}

.case-relationship > span {
  padding: 2px 4px;
  background: white;
}

.odp-role {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.3;
}

.digital-layer .odp-role {
  width: 100%;
  padding-left: 9px;
  border-left: 2px solid var(--navy);
}

.digital-layer small {
  color: var(--orange);
  font-size: 10px;
  line-height: 1.25;
}

.case-bottom {
  margin-right: 108px;
}

.presentation-slide[data-view="2"] .case-bottom {
  margin-top: clamp(8px, 1.2vh, 12px);
}

.case-insight-label {
  margin: 0 0 4px;
  color: var(--orange);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.case-takeaway {
  margin: 0;
  padding-left: 10px;
  border-left: 3px solid var(--orange);
  color: var(--navy);
  font-size: clamp(15px, 1.5vw, 18px);
  font-weight: 750;
  line-height: 1.25;
}

.case-citations {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.35;
}

@media (max-width: 900px) {
  .case-layer {
    padding: 8px;
  }

  .case-bottom {
    margin-right: 92px;
  }
}

@media (max-width: 580px) {
  .case-view-content {
    gap: 9px;
    padding: 16px 0 70px;
  }

  .case-heading h2 {
    font-size: clamp(24px, 7vw, 32px);
  }

  .case-heading p {
    font-size: 12px;
  }

  .case-statistics > div {
    padding: 0 8px;
  }

  .case-statistics strong {
    font-size: clamp(18px, 5vw, 24px);
  }

  .case-statistics span {
    font-size: 8px;
  }

  .case-diagram {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  .case-layer {
    padding: 7px 9px;
  }

  .case-relationship {
    min-height: 10px;
  }

  .case-relationship::before {
    width: 1px;
    height: 100%;
    margin: -100% 0;
    border-top: 0;
    border-left: 1px dashed var(--orange);
  }

  .case-relationship > span {
    padding: 1px 5px;
  }

  .digital-layer .odp-role {
    padding: 3px 0 3px 8px;
    border-top: 0;
    border-left: 0;
    box-shadow: inset 2px 0 var(--navy);
  }

  .case-bottom {
    margin-right: 0;
  }

  .case-citations {
    max-width: calc(100% - 96px);
  }

  .presentation-slide[data-view="2"] .slide-overline {
    margin-left: -8px;
  }

  .presentation-slide[data-view="2"] .slide-overline span:first-child {
    font-size: 8px;
    letter-spacing: 0.06em;
  }

  .presentation-slide[data-view="3"] .slide-overline {
    margin-left: -8px;
  }

  .presentation-slide[data-view="3"] .slide-overline span:first-child {
    font-size: 8px;
    letter-spacing: 0.06em;
  }
}

.evidence-grid,
.comparison-grid,
.design-principles,
.governance-chain,
.justice-triad,
.evaluation-matrix,
.conclusion-recommendations {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 35px;
}

.justice-triad {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.conclusion-recommendations {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.cover-slide .slide-citation {
  color: rgba(255, 255, 255, 0.72);
}

.cover-slide .slide-citation a {
  color: white;
}

.evidence-item,
.design-principles > div,
.justice-triad > div {
  min-height: 105px;
  padding: 18px;
  border-top: 3px solid var(--orange);
  background: #f2f6f9;
}

.evidence-item > span,
.design-principles > div > span,
.justice-triad > div > span {
  display: block;
  margin-bottom: 14px;
  color: var(--orange);
  font-family: Georgia, serif;
  font-size: 16px;
}

.evidence-item strong,
.design-principles strong,
.justice-triad strong {
  display: block;
  color: var(--navy);
  font-size: 14px;
}

.evidence-item small {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: 9px;
}

.comparison-grid {
  grid-template-columns: 1fr auto 1fr;
  align-items: stretch;
}

.comparison-column {
  min-height: 145px;
  padding: 21px 24px;
  border: 1px solid var(--line);
  background: white;
}

.comparison-new {
  border-color: rgba(239, 124, 0, 0.4);
  background: #fff8f1;
}

.comparison-tag {
  color: var(--muted);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.comparison-new .comparison-tag {
  color: var(--orange);
}

.comparison-column h3 {
  margin: 9px 0;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 25px;
}

.comparison-column p {
  max-width: 340px;
  margin: 0;
  color: #506477;
  font-size: 12px;
}

.comparison-column small {
  display: block;
  margin-top: 15px;
  color: var(--navy);
  font-size: 9px;
  font-weight: 800;
}

.comparison-arrow {
  align-self: center;
  color: var(--orange);
  font-size: 25px;
}

.service-flow {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto 1fr;
  gap: 13px;
  align-items: center;
  margin-top: 41px;
}

.presentation-slide[data-view="6"] .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.presentation-slide[data-view="6"] .slide-overline span:last-child {
  margin-left: auto;
}

.presentation-slide[data-view="6"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.smart-operations-content {
  display: grid;
  width: min(100%, 1120px);
  gap: clamp(7px, 1vh, 10px);
  margin: auto;
  padding: 0;
}

.smart-operations-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(27px, 3vw, 36px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.smart-operations-heading p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: clamp(11px, 1.2vw, 15px);
}

.operations-process {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 24px minmax(0, 1fr) 24px minmax(0, 1fr) 24px minmax(0, 1fr);
  align-items: stretch;
}

.operations-stage {
  display: flex;
  min-width: 0;
  min-height: 112px;
  flex-direction: column;
  justify-content: center;
  padding: 10px 12px;
  border-top: 3px solid var(--orange);
  background: #f5f8fa;
}

.operations-step {
  color: var(--orange);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 16px;
}

.operations-stage h3 {
  margin: 4px 0;
  color: var(--navy);
  font-size: clamp(16px, 1.65vw, 20px);
  line-height: 1.15;
}

.operations-stage p {
  margin: 0;
  color: #506477;
  font-size: clamp(12px, 1.15vw, 14px);
  line-height: 1.35;
}

.operations-arrow {
  align-self: center;
  color: var(--orange);
  font-size: 24px;
  font-weight: 800;
  text-align: center;
}

.operations-process-note {
  margin: -4px 0 0;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.3;
}

.operations-critique {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: clamp(10px, 1.4vh, 16px);
}

.operations-panel {
  min-width: 0;
  padding: 8px 11px;
  border: 1px solid var(--line);
  background: white;
}

.operations-people {
  border-top: 3px solid var(--navy);
}

.operations-footprint {
  border-top: 3px solid var(--orange);
}

.operations-panel h3 {
  margin: 0 0 4px;
  color: var(--navy);
  font-size: 18px;
  text-transform: uppercase;
}

.operations-benefit {
  margin: 0;
  color: #405467;
  font-size: clamp(14px, 1.35vw, 16px);
  line-height: 1.3;
}

.operations-benefit span {
  display: block;
  margin-bottom: 2px;
  color: var(--orange);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.operations-citation {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 8px;
}

.operations-takeaway {
  margin: 0 108px 0 0;
  padding: 8px 11px;
  border-left: 3px solid var(--orange);
  background: #f2f6f9;
  color: var(--navy);
  font-size: clamp(13px, 1.5vw, 18px);
  font-weight: 800;
  line-height: 1.25;
}

.operations-sources {
  margin-right: 108px;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.3;
}

.presentation-slide[data-view="7"] .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.presentation-slide[data-view="7"] .slide-overline span:last-child {
  margin-left: auto;
}

.presentation-slide[data-view="7"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.human-development-content {
  display: grid;
  width: min(100%, 1120px);
  gap: clamp(7px, 1vh, 10px);
  margin: auto;
  padding: 0;
}

.human-development-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(28px, 3.2vw, 40px);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.human-development-heading p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: clamp(12px, 1.2vw, 15px);
}

.human-outcome-panels {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.human-outcome-panel {
  position: relative;
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-top: 3px solid var(--orange);
  background: #f8fafc;
}

.human-panel-number {
  position: absolute;
  top: 10px;
  right: 12px;
  color: rgba(0, 61, 124, 0.2);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 25px;
  line-height: 1;
}

.human-outcome-panel h3 {
  min-height: 1.2em;
  margin: 0 28px 6px 0;
  color: var(--navy);
  font-size: clamp(18px, 1.7vw, 21px);
  line-height: 1.15;
  text-transform: uppercase;
}

.human-panel-image-placeholder {
  display: grid;
  min-height: 38px;
  margin-bottom: 8px;
  place-items: center;
  border: 1px dashed #9aabba;
  background:
    linear-gradient(135deg, rgba(0, 61, 124, 0.045) 25%, transparent 25%) 0 0 / 12px 12px,
    #f2f6f9;
  color: var(--muted);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.human-panel-stage > span,
.human-critical-question > span {
  display: block;
  margin-bottom: 3px;
  color: var(--orange);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.human-panel-stage p {
  margin: 0;
  color: #405467;
  font-size: 12px;
  line-height: 1.35;
}

.human-stage-arrow {
  align-self: center;
  margin: 1px 0;
  color: var(--orange);
  font-size: 17px;
  line-height: 1;
}

.human-critical-question {
  margin-top: 8px;
  padding-top: 7px;
  border-top: 1px solid var(--line);
}

.human-critical-question strong {
  display: block;
  color: var(--navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(15px, 1.35vw, 17px);
  line-height: 1.25;
}

.human-panel-citation {
  margin: auto 0 0;
  padding-top: 8px;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.3;
}

.human-development-takeaway {
  margin: 0;
  padding: 8px 11px;
  border-left: 3px solid var(--orange);
  background: #f2f6f9;
  color: var(--navy);
  font-size: clamp(13px, 1.45vw, 17px);
  font-weight: 800;
  line-height: 1.25;
}

.human-development-sources {
  margin-right: 108px;
  color: var(--muted);
  font-size: 9px;
  line-height: 1.3;
}

.presentation-slide[data-view="8"] .slide-overline {
  align-items: center;
  margin-left: -14px;
}

.presentation-slide[data-view="8"] .slide-overline span:last-child {
  margin-left: auto;
}

.presentation-slide[data-view="8"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.presentation-slide[data-view="8"] .governance-view-content {
  display: grid;
  width: min(100%, 1120px);
  gap: 3px;
  margin: auto;
  padding: 0;
  transform: none;
}

.presentation-slide[data-view="8"] .governance-actor-stack {
  grid-template-columns: minmax(0, 1fr) 100px minmax(0, 1fr);
  align-items: stretch;
  gap: 10px;
}

.presentation-slide[data-view="8"] .governance-actor {
  display: flex;
  min-height: 0;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  padding: 9px;
  text-align: center;
}

.presentation-slide[data-view="8"] .governance-image-placeholder {
  width: 100%;
  height: clamp(110px, 14vh, 150px);
  flex: 0 0 auto;
  margin: 0 0 7px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: white;
}

.presentation-slide[data-view="8"] .governance-image-placeholder img {
  width: 100%;
  height: 100%;
  padding: 10px;
  object-fit: contain;
}

.presentation-slide[data-view="8"] img[src="assets/JTC-logo.png"] {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: calc(clamp(110px, 14vh, 150px) - 2px);
  padding: 0;
  object-fit: contain;
  object-position: center;
  background-color: #f7fafc;
}

@media (max-width: 900px) {
  .presentation-slide[data-view="8"] img[src="assets/JTC-logo.png"] {
    max-height: calc(clamp(100px, 18vh, 140px) - 2px);
  }
}

.presentation-slide[data-view="8"] .governance-actor h3 {
  margin-top: 0;
}

.presentation-slide[data-view="8"] .governance-actor p {
  margin-top: 3px;
}

@media (max-width: 900px) {
  .presentation-slide[data-view="8"] .governance-actor-stack {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  .presentation-slide[data-view="8"] .governance-image-placeholder {
    height: clamp(100px, 18vh, 140px);
  }
}

.governance-view-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(27px, 3vw, 36px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.governance-view-heading p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: clamp(11px, 1.15vw, 14px);
}

.governance-relationship-diagram {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) 56px minmax(0, 0.7fr);
  align-items: center;
  gap: 5px;
  padding: 9px 11px 7px;
  border: 1px solid var(--line);
  background: #f7fafc;
}

.governance-institutions,
.governance-stakeholders {
  min-width: 0;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.75);
}

.governance-group-label {
  margin: 0 0 5px;
  color: var(--orange);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.11em;
}

.governance-institution-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
}

.governance-actor-stack {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 78px minmax(0, 1fr);
  align-items: center;
  gap: 3px;
}

.governance-actor {
  min-width: 0;
  min-height: 64px;
  padding: 6px;
  border: 1px solid var(--line);
  background: white;
}

.governance-actor h3 {
  margin: 0;
  color: var(--navy);
  font-size: 12px;
}

.governance-actor p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 9px;
  line-height: 1.25;
}

.governance-image-placeholder {
  display: grid;
  height: 30px;
  margin-top: 4px;
  place-items: center;
  background: white;
}

.governance-image-placeholder img {
  display: block;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.governance-collaboration {
  display: grid;
  justify-items: center;
  gap: 3px;
  text-align: center;
}

.governance-solid-line {
  width: min(100%, 74px);
  border-top: 2px solid var(--navy);
}

.governance-collaboration small {
  color: var(--navy);
  font-size: 8px;
  font-weight: 750;
  line-height: 1.15;
}

.governance-platform-connection {
  display: grid;
  justify-items: center;
  gap: 2px;
  margin: 1px 0;
  text-align: center;
}

.governance-platform-connection > span {
  height: 4px;
  border-left: 1px solid var(--navy);
}

.governance-platform-connection small {
  color: var(--muted);
  font-size: 8px;
  line-height: 1.15;
}

.governance-platform {
  padding: 6px 9px;
  border: 1px solid rgba(239, 124, 0, 0.45);
  border-left: 3px solid var(--orange);
  background: #fff;
}

.governance-platform > span {
  color: var(--orange);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.governance-platform h3 {
  margin: 2px 0;
  color: var(--navy);
  font-size: 13px;
}

.governance-platform p {
  margin: 0;
  color: #405467;
  font-size: 10px;
  font-weight: 700;
}

.governance-platform > small {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 8px;
}

.governance-stakeholder-connection {
  display: grid;
  justify-items: center;
  gap: 3px;
  text-align: center;
}

.governance-dashed-line {
  width: 100%;
  border-top: 1px dashed var(--orange);
}

.governance-stakeholder-connection small {
  color: #855000;
  font-size: 8px;
  font-weight: 750;
  line-height: 1.2;
}

.governance-stakeholder-list {
  display: grid;
  justify-items: start;
  gap: 7px;
}

.governance-stakeholder-list span {
  position: relative;
  display: flex;
  min-height: 28px;
  align-items: center;
  padding: 5px 10px 5px 22px;
  border-radius: 999px;
  border: 1px solid #dfe7ef;
  background: #eaf0f5;
  color: var(--navy);
  font-size: 10px;
  font-weight: 700;
}

.governance-stakeholder-list span::before {
  position: absolute;
  top: 50%;
  left: 9px;
  width: 5px;
  height: 5px;
  transform: translateY(-50%);
  border-radius: 50%;
  background: var(--orange);
  content: "";
}

.governance-diagram-caption {
  grid-column: 1 / -1;
  margin: 0;
  color: var(--muted);
  font-size: 8px;
  line-height: 1.2;
}

.governance-analysis-panels {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  align-items: start;
}

.governance-analysis-panel {
  min-width: 0;
  padding: 7px 9px;
  border-top: 2px solid var(--navy);
  background: #f5f8fa;
}

.governance-strength {
  padding: 6px 8px;
}

.governance-analysis-panel.governance-strength p {
  font-size: 11px;
}

.governance-accountability {
  border-top-color: var(--orange);
  background: #fff8f1;
}

.governance-analysis-panel span {
  display: block;
  margin-bottom: 3px;
  color: var(--orange);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.governance-analysis-panel p {
  margin: 0;
  color: var(--navy);
  font-size: clamp(11px, 1.2vw, 14px);
  font-weight: 750;
  line-height: 1.25;
}

.governance-critical-takeaway {
  margin: 0;
  padding: 7px 10px;
  border-left: 3px solid var(--orange);
  background: #f2f6f9;
  color: var(--navy);
  font-size: clamp(12px, 1.35vw, 16px);
  font-weight: 800;
  line-height: 1.25;
}

@media (max-width: 900px) {
  .governance-analysis-panels {
    grid-template-columns: 1fr;
  }

  .governance-actor-stack {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 901px) and (max-width: 1100px) {
  .governance-actor {
    min-height: 66px;
    padding: 6px;
  }

  .governance-image-placeholder {
    height: 30px;
    margin-top: 4px;
  }
}

.governance-view-sources {
  margin-right: 108px;
  color: var(--navy);
  font-size: 9px;
  line-height: 1.25;
}

.presentation-slide[data-view="9"] .slide-overline {
  align-items: center;
  margin-left: -14px;
  transform: translateY(-12.72px);
}

.presentation-slide[data-view="9"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.presentation-slide[data-view="9"] .slide-overline span:last-child {
  margin-left: auto;
}

.environmental-justice-content {
  display: grid;
  width: min(100%, 1120px);
  gap: 5px;
  margin: auto;
  padding: 0;
}

.environmental-justice-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(27px, 3vw, 36px);
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.environmental-justice-heading p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: clamp(11px, 1.15vw, 14px);
}

.justice-dimensions-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.justice-dimension-panel {
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 9px 11px;
  border: 1px solid var(--line);
  border-top: 2px solid var(--orange);
  background: #f7f9fb;
}

.justice-dimension-heading {
  display: flex;
  align-items: center;
  gap: 8px;
}

.justice-dimension-heading > span {
  display: grid;
  width: 25px;
  height: 25px;
  flex: 0 0 25px;
  place-items: center;
  border-radius: 50%;
  background: #eaf0f5;
  color: var(--orange);
  font-size: 14px;
  font-weight: 800;
}

.justice-dimension-heading h3 {
  margin: 0;
  color: var(--navy);
  font-size: 14px;
  line-height: 1.1;
  text-transform: uppercase;
}

.justice-dimension-heading p {
  margin: 2px 0 0;
  color: #53687a;
  font-size: 9px;
  line-height: 1.2;
}

.justice-evidence {
  margin-top: 6px;
}

.justice-evidence > span {
  color: var(--orange);
  font-size: 7px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.justice-evidence p {
  margin: 2px 0 0;
  color: #405467;
  font-size: 10px;
  line-height: 1.25;
}

.justice-evidence small {
  display: block;
  margin-top: 2px;
  color: var(--muted);
  font-size: 7px;
  line-height: 1.15;
}

.justice-critical-question {
  margin: auto 0 0;
  padding: 5px 7px;
  border-left: 2px solid var(--orange);
  background: #fff;
  color: var(--navy);
  font-size: 10px;
  font-weight: 800;
  line-height: 1.2;
}

.environmental-justice-insight {
  margin: 0;
  padding: 7px 10px;
  border-left: 3px solid var(--orange);
  background: #f2f6f9;
  color: var(--navy);
  font-size: clamp(12px, 1.25vw, 15px);
  font-weight: 800;
  line-height: 1.25;
}

.environmental-justice-sources {
  margin-right: 108px;
  color: var(--navy);
  font-size: 8px;
  line-height: 1.2;
}

.presentation-slide[data-view="9"] .justice-dimension-panel {
  padding: 10px 12px;
}

.presentation-slide[data-view="9"] .justice-dimension-heading {
  gap: 9px;
}

.presentation-slide[data-view="9"] .justice-dimension-heading > span {
  width: 28px;
  height: 28px;
  flex-basis: 28px;
  font-size: 16px;
}

.presentation-slide[data-view="9"] .justice-dimension-heading h3 {
  font-size: 16px;
}

.presentation-slide[data-view="9"] .justice-dimension-heading p {
  font-size: 11px;
}

.presentation-slide[data-view="9"] .justice-evidence {
  margin-top: 7px;
}

.presentation-slide[data-view="9"] .justice-evidence > span {
  font-size: 8px;
}

.presentation-slide[data-view="9"] .justice-evidence p {
  font-size: 12px;
  line-height: 1.25;
}

.presentation-slide[data-view="9"] .justice-evidence small {
  font-size: 9px;
}

.presentation-slide[data-view="9"] .justice-critical-question {
  padding: 6px 8px;
  font-size: 12px;
}

@media (max-width: 900px) {
  .presentation-slide[data-view="9"] .slide-overline {
    margin-left: -8px;
  }

  .presentation-slide[data-view="9"] .slide-overline span:first-child {
    font-size: 8px;
    letter-spacing: 0.06em;
  }
}

@media (max-width: 580px) {
  .justice-dimensions-grid {
    gap: 6px;
  }

  .presentation-slide[data-view="9"] .justice-dimension-heading h3 {
    font-size: 13px;
  }

  .presentation-slide[data-view="9"] .justice-evidence p,
  .presentation-slide[data-view="9"] .justice-critical-question {
    font-size: 10px;
  }

  .justice-dimension-panel {
    padding: 7px;
  }

  .justice-dimension-heading {
    gap: 5px;
  }

  .justice-dimension-heading h3 {
    font-size: 12px;
  }

  .justice-evidence p,
  .justice-critical-question {
    font-size: 9px;
  }

  .environmental-justice-sources {
    margin-right: 0;
  }
}

.presentation-slide[data-view="10"] .slide-overline {
  align-items: center;
  margin-left: -14px;
  transform: translateY(-12.72px);
}

.presentation-slide[data-view="10"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.presentation-slide[data-view="10"] .slide-overline span:last-child {
  margin-left: auto;
}

.presentation-slide[data-view="11"] .slide-overline {
  align-items: center;
  margin-left: -14px;
  transform: translateY(-12.72px);
}

.presentation-slide[data-view="11"] .slide-overline span:first-child {
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
}

.presentation-slide[data-view="11"] .slide-overline span:last-child {
  margin-left: auto;
}

.sets-evaluation-content {
  position: relative;
  z-index: 1;
  display: grid;
  width: min(100%, 1120px);
  gap: clamp(4px, 0.7vh, 7px);
  margin: auto;
  padding: 0;
}

.sets-evaluation-heading h2 {
  margin: 0;
  color: var(--navy);
  font-size: clamp(25px, 3vw, 36px);
  line-height: 1.04;
  letter-spacing: -0.045em;
}

.sets-evaluation-heading {
  padding-bottom: 1px;
}

.sets-evaluation-heading h2 em {
  color: var(--orange);
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
}

.sets-evaluation-heading p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: clamp(10px, 1.1vw, 13px);
  line-height: 1.25;
}

.sets-evaluation-figure {
  display: grid;
  margin: 0;
  padding-bottom: 1px;
}

.sets-evaluation-model {
  position: relative;
  height: 285px;
}

.sets-evaluation-arrows {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.sets-evaluation-arrows path {
  fill: none;
  stroke: var(--orange);
  stroke-width: 2;
  marker-start: url(#sets-arrow);
  marker-end: url(#sets-arrow);
}

.sets-evaluation-node {
  position: absolute;
  z-index: 1;
  display: grid;
  width: 31%;
  min-height: 78px;
  align-content: center;
  justify-items: center;
  padding: 6px 9px;
  border: 1px solid var(--line);
  background: #fff;
  text-align: center;
}

.sets-evaluation-node > span {
  display: grid;
  width: 24px;
  height: 24px;
  place-items: center;
  border-radius: 50%;
  background: var(--navy);
  color: white;
  font-size: 15px;
  font-weight: 800;
  line-height: 1;
}

.sets-evaluation-node strong {
  margin-top: 3px;
  color: var(--orange);
  font-size: 10px;
  letter-spacing: 0.1em;
}

.sets-evaluation-node p {
  margin: 2px 0 0;
  color: var(--navy);
  font-size: clamp(13px, 1.4vw, 16px);
  font-weight: 800;
  line-height: 1.2;
}

.sets-evaluation-node small {
  margin-top: 2px;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.15;
}

.sets-evaluation-technology {
  top: 0;
  left: 36%;
  width: 28%;
  border-top: 2px solid var(--orange);
}

.sets-evaluation-technology > span {
  background: var(--orange);
}

.sets-evaluation-ecology {
  bottom: 0;
  left: 4%;
  border-top: 2px solid #507a60;
}

.sets-evaluation-ecology > span {
  background: #507a60;
}

.sets-evaluation-social {
  right: 4%;
  bottom: 0;
  border-top: 2px solid var(--navy);
}

.sets-evaluation-governance {
  position: absolute;
  z-index: 2;
  top: 158px;
  left: 50%;
  display: flex;
  width: min(16.5%, 140px);
  aspect-ratio: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 12px;
  border: 1px solid var(--line);
  border-top: 3px solid var(--orange);
  border-radius: 50%;
  background: #f2f6f9;
  text-align: center;
  transform: translateX(-50%);
  box-shadow: 0 0 0 4px #fff;
}

.sets-evaluation-governance strong {
  color: var(--navy);
  font-size: 8px;
  line-height: 1.15;
  letter-spacing: 0.04em;
}

.sets-evaluation-governance span {
  color: #405467;
  font-size: 8px;
  line-height: 1.15;
}

.sets-evaluation-governance small {
  color: var(--muted);
  font-size: 7px;
  line-height: 1.1;
}

.sets-evaluation-figure figcaption {
  margin-top: 3px;
  color: var(--muted);
  font-size: 7px;
  line-height: 1.15;
  text-align: right;
}

.sets-evaluation-panels {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.sets-evaluation-panels article {
  padding: 6px 9px;
  border: 1px solid var(--line);
  border-top: 2px solid var(--orange);
  background: #f7f9fb;
}

.sets-evaluation-panels article + article {
  border-top-color: var(--navy);
}

.sets-evaluation-panels article span {
  display: block;
  color: var(--orange);
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.sets-evaluation-panels article + article span {
  color: var(--navy);
}

.sets-evaluation-panels p {
  margin: 3px 0 0;
  color: #405467;
  font-size: clamp(9px, 0.95vw, 11px);
  font-weight: 650;
  line-height: 1.2;
}

.sets-evaluation-takeaway {
  margin: 0;
  padding: 6px 9px;
  border-left: 3px solid var(--orange);
  background: #fff8f1;
  color: var(--navy);
  font-size: clamp(12px, 1.25vw, 15px);
  font-weight: 850;
  line-height: 1.2;
}

.sets-evaluation-citations {
  display: flex;
  justify-content: space-between;
  margin-right: 108px;
  gap: 8px;
  color: var(--muted);
  font-size: 7px;
  line-height: 9px;
}

.sets-evaluation-citations > span:first-child {
  color: var(--orange);
  font-weight: 800;
}

.sets-evaluation-citations a {
  color: inherit;
  text-decoration-color: var(--orange);
  text-underline-offset: 2px;
}

