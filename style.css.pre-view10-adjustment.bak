  margin: 0;
  line-height: 1.35;
}

.presentation-slide[data-view="8"] .governance-analysis-panels {
  margin-top: 8px;
  align-items: stretch;
}

.presentation-slide[data-view="10"] .sets-evaluation-governance {
  top: 108px;
  left: 50%;
  width: min(28%, 250px);
  height: 82px;
  aspect-ratio: auto;
