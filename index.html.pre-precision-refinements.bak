              </header>

              <section class="smart-comparison" aria-label="Smart urbanism analytical approaches">
                <article class="smart-approach smart-approach-technology">
                  <span class="smart-approach-tag">SMART CITY 1.0</span>
                  <h3><svg class="smart-approach-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M4 42h40M8 42V21h13v21M26 42V8h14v34M12 27h5m-5 7h5m13-20h5m-5 8h5m-5 8h5m-5 8h5"/><circle cx="19" cy="8" r="2"/><circle cx="7" cy="8" r="2"/><path d="M9 8h8m4 0h5"/></svg>Technology-led</h3>
