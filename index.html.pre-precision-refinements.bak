                <div><svg class="refinement-icon stat-icon" viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="15" width="36" height="26" rx="4"/><path d="M17 15v-5h14v5M6 25h36m-23 0v4h10v-4"/></svg><strong>28,000</strong><span>Planned jobs</span></div>
                <div><svg class="refinement-icon stat-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="m4 18 20-11 20 11-20 11L4 18Z M12 23v10c7 6 17 6 24 0V23M43 19v14"/></svg><strong>12,000</strong><span>Planned students</span></div>
